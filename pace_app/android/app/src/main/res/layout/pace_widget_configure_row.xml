<?xml version="1.0" encoding="utf-8"?>
<!-- One layout choice. The chosen one gets the mint fill and a check, so it
     is never marked by colour alone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/pace_widget_option"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/option_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pace_widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/option_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pace_widget_accent"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/option_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/pace_widget_check"
        android:visibility="invisible" />
</LinearLayout>
